<ui version="4.0">
 <class>SOLISExposureDialog</class>
 <widget class="QDialog" name="SOLISExposureDialog">
  <property name="windowTitle"><string>SOLIS Canopy Exposure</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QGroupBox" name="metricsGroupBox"><property name="title"><string>Exposure metrics</string></property><layout class="QVBoxLayout" name="metricsLayout">
    <item><widget class="QCheckBox" name="skyCheckBox"><property name="text"><string>Sky Exposure Factor — geometric upper-hemisphere openness</string></property><property name="checked"><bool>true</bool></property></widget></item>
    <item><widget class="QCheckBox" name="sunCheckBox"><property name="text"><string>Sun Exposure Fraction — fraction of daylight time with direct sun access</string></property><property name="checked"><bool>true</bool></property></widget></item>
    <item><widget class="QCheckBox" name="radiativeCheckBox"><property name="text"><string>Radiative Exposure Index — received / unobstructed clear-sky radiation</string></property><property name="checked"><bool>true</bool></property></widget></item>
   </layout></widget></item>
   <item><widget class="QGroupBox" name="contextGroupBox"><property name="title"><string>Occlusion context</string></property><layout class="QGridLayout" name="contextGrid">
    <item row="0" column="0"><widget class="QLabel" name="contextLabel"><property name="text"><string>Geometry that can block sky/sun</string></property></widget></item>
    <item row="0" column="1"><widget class="QComboBox" name="contextComboBox"><property name="currentIndex"><number>1</number></property>
     <item><property name="text"><string>Target only</string></property></item>
     <item><property name="text"><string>Selected entities</string></property></item>
     <item><property name="text"><string>All visible entities</string></property></item>
    </widget></item>
    <item row="1" column="0" colspan="2"><widget class="QLabel" name="contextHintLabel"><property name="text"><string>Selected entities mutually occlude each other; results are still written separately to each selected target.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   </layout></widget></item>
   <item><widget class="QGroupBox" name="crownGroupBox"><property name="title"><string>Crown summary</string></property><layout class="QGridLayout" name="crownGrid">
    <item row="0" column="0" colspan="4"><widget class="QCheckBox" name="crownSummaryCheckBox"><property name="text"><string>Crown Exposure Index (spatially weighted mean REI)</string></property><property name="checked"><bool>true</bool></property></widget></item>
    <item row="1" column="0"><widget class="QCheckBox" name="voxelAutoCheckBox"><property name="text"><string>Automatic point-cloud voxel size</string></property><property name="checked"><bool>true</bool></property></widget></item>
    <item row="1" column="1"><widget class="QDoubleSpinBox" name="voxelSizeSpinBox"><property name="minimum"><double>0.000001</double></property><property name="maximum"><double>1000000.0</double></property><property name="decimals"><number>4</number></property><property name="value"><double>0.2</double></property><property name="suffix"><string> m</string></property></widget></item>
    <item row="1" column="2"><widget class="QLabel" name="thresholdLabel"><property name="text"><string>Exposed threshold</string></property></widget></item>
    <item row="1" column="3"><widget class="QDoubleSpinBox" name="thresholdSpinBox"><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1.0</double></property><property name="singleStep"><double>0.05</double></property><property name="decimals"><number>2</number></property><property name="value"><double>0.75</double></property></widget></item>
    <item row="2" column="0" colspan="4"><widget class="QLabel" name="weightingLabel"><property name="text"><string>Point clouds use occupied-voxel weighting; meshes use surface-area weighting.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
